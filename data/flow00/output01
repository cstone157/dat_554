def check_square_sum(a, b, c):
    """
    Checks if the sum of the squares of the first two parameters equals
    the square of the third parameter.
    
    Args:
        a (int or float): First numeric parameter
        b (int or float): Second numeric parameter
        c (int or float): Third numeric parameter
        
    Returns:
        bool: True if a^2 + b^2 == c^2, otherwise False
    """
    return (a ** 2) + (b ** 2) == (c ** 2)
