def check_sum_of_squares(a, b, c):
    """
    Checks if the sum of the squares of the first two parameters equals the square of the third parameter.
    Validates that all inputs are numeric.
    """
    # Validate that all parameters are numeric (int or float)
    for val in (a, b, c):
        if not isinstance(val, (int, float)):
            raise TypeError("All parameters must be numeric.")

    # Check the mathematical condition: a^2 + b^2 == c^2
    return (a ** 2) + (b ** 2) == (c ** 2)
