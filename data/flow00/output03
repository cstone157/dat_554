import math

def check_pythagorean_identity(a, b, c):
    # Validate that all parameters are numeric (int or float)
    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)) or not isinstance(c, (int, float)):
        raise TypeError("All parameters must be numeric.")

    # Calculate the sum of the squares of the first two variables
    sum_of_squares = a**2 + b**2
    # Calculate the square of the third variable
    square_of_third = c**2

    # Use math.isclose() to safely compare the values, accounting for floating-point precision
    return math.isclose(sum_of_squares, square_of_third)
