def dot_product(vec1, vec2):
    """
    Calculate the dot product of two vectors.
    
    Args:
        vec1 (iterable): First vector containing numeric values.
        vec2 (iterable): Second vector containing numeric values.
        
    Returns:
        int or float: The calculated dot product.
        
    Raises:
        ValueError: If the input vectors have different lengths.
    """
    # Ensure both vectors have the same dimensionality
    if len(vec1) != len(vec2):
        raise ValueError("Both vectors must have the same number of elements.")
        
    # Compute the sum of element-wise products using a generator expression
    return sum(a * b for a, b in zip(vec1, vec2))
