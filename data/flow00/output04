import math

def check_squares(a, b, c):
    # Validate that all inputs are strictly numeric (int or float) and explicitly exclude booleans
    for val in (a, b, c):
        if type(val) not in (int, float):
            raise TypeError("Inputs must be numeric values (int or float), not booleans.")
            
    # Use math.isclose() to check if the sum of the squares of the first two parameters 
    # equals the square of the third parameter
    return math.isclose(a**2 + b**2, c**2)
