import math

def check_squares(a, b, c):
    # Explicitly reject booleans since they are a subclass of int in Python
    if isinstance(a, bool) or isinstance(b, bool) or isinstance(c, bool):
        raise TypeError("Boolean values are not allowed.")
        
    # Ensure all parameters are numeric types (int or float)
    if not (isinstance(a, (int, float)) and isinstance(b, (int, float)) and isinstance(c, (int, float))):
        raise TypeError("All parameters must be numeric types.")
        
    # Verify if the sum of the squares of the first two parameters equals the square of the third
    return math.isclose(a**2 + b**2, c**2)
